# Environment variables for Mnemosine
# Configure these values for your development environment

# MongoDB Connection - Update with your MongoDB URI
MONGODB_URI=mongodb+srv://<username>:<password>@mnemosine.pth7snp.mongodb.net/?appName=Mnemosine

# NextAuth Configuration
