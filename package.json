{
  "name": "mnemosine",
  "displayName": "Mnemosine: Allenamenti",
  "version": "4.1.1",
  "private": true,
  "license": "MIT",
  "icon": "public/mnemosine-logo.svg",
  "author": "Ornitorink0",
  "description": "A web app designed to support doctors and healthcare professionals in the early diagnosis of Alzheimer's, through interactive exercises designed to stimulate and evaluate users' memory and cognitive abilities",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write .",
    "clear:next": "rm -rf .next",
    "clear:cache": "rm -rf node_modules/.cache",
    "clear:all": "rm -rf .next node_modules",
    "cli": "tsx scripts/manage-users.ts",
    "prepare": "husky"
  },
  "keywords": [
    "alzheimer",
    "diagnosis",
    "memory",
    "cognitive",
    "exercises",
    "healthcare",
    "doctors",
    "professionals"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Ornitorink0/mnemosine.git"
  },
  "bugs": {
    "url": "https://github.com/Ornitorink0/mnemosine/issues"
  },
  "directories": {
    "app": "app",
    "components": "components",
    "docs": "docs",
    "lib": "lib",
    "models": "models",
    "public": "public",
    "tests": "tests",
    "types": "types",
    "utils": "utils"
  },
  "markdown": "github",
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@stepperize/react": "^5.1.9",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/analytics": "^1.6.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "eslint-config-prettier": "^10.1.8",
    "framer-motion": "^12.24.10",
    "lucide-react": "^0.562.0",
    "mongodb": "^7.0.0",
    "mongoose": "^9.1.2",
    "motion": "^12.26.2",
    "next": "16.1.1",
    "next-auth": "^4.24.13",
    "next-themes": "^0.4.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@next/eslint-plugin-next": "^16.1.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.52.0",
    "commander": "^14.0.2",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.1.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "inquirer": "^13.1.0",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
