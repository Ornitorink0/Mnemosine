{
  "name": "mnemosine",
  "displayName": "Mnemosine: Allenamenti",
  "version": "3.6.5",
  "private": true,
  "license": "MIT",
  "icon": "public/mnemosine-logo.svg",
  "author": "Ornitorink0",
  "description": "A web app designed to support doctors and healthcare professionals in the early diagnosis of Alzheimer's, through interactive exercises designed to stimulate and evaluate users' memory and cognitive abilities",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "clear:next": "rm -rf .next",
    "clear:cache": "rm -rf node_modules/.cache",
    "clear:all": "rm -rf .next node_modules",
    "prepare": "husky && husky install",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "alzheimer",
    "diagnosis",
    "memory",
    "cognitive",
    "exercises",
    "healthcare",
    "doctors",
    "professionals"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Ornitorink0/mnemosine.git"
  },
  "bugs": {
    "url": "https://github.com/Ornitorink0/mnemosine/issues"
  },
  "directories": {
    "app": "app",
    "components": "components",
    "docs": "docs",
    "lib": "lib",
    "models": "models",
    "public": "public",
    "tests": "tests",
    "types": "types",
    "utils": "utils"
  },
  "markdown": "github",
  "dependencies": {
    "@next/bundle-analyzer": "^15.3.3",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@tanstack/react-table": "^8.21.3",
    "bcrypt": "^5.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.16.0",
    "lucide-react": "^0.487.0",
    "mongodb": "^6.15.0",
    "mongoose": "^8.13.2",
    "motion": "^12.16.0",
    "next": "15.2.4",
    "next-auth": "^4.24.11",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.1.0",
    "tw-animate-css": "^1.2.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-jest": "^30.0.0-beta.3",
    "dotenv": "^16.4.7",
    "eslint": "^9.28.0",
    "eslint-config-next": "15.2.4",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.1",
    "husky": "^8.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.0.0-beta.3",
    "lint-staged": "^16.1.0",
    "node-mocks-http": "^1.17.2",
    "prettier": "^3.5.3",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
