{
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install",
  "framework": "nextjs",
  "nodeVersion": "20.x",
  "env": {
    "NEXTAUTH_URL": "@mnemosine_nextauth_url",
    "NEXTAUTH_SECRET": "@mnemosine_nextauth_secret",
    "MONGODB_URI": "@mnemosine_mongodb_uri"
  },
  "redirects": [
    {
      "source": "/dashboard",
      "destination": "/login",
      "statusCode": 307,
      "has": [
        {
          "type": "cookie",
          "key": "next-auth.session-token",
          "value": "^(?!.*)$"
        }
      ]
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
